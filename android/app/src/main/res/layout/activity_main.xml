<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp">

    <TextView
        android:id="@+id/header"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="BBSaarthi - App Skeleton"
        android:textSize="20sp"
        android:layout_marginBottom="16dp" />

    <Button
        android:id="@+id/btn_feature1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Feature Link 1" />

    <Button
        android:id="@+id/btn_feature2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Feature Link 2"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_feature3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Feature Link 3"
        android:layout_marginTop="8dp" />

    <Button
        android:id="@+id/btn_feature4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Feature Link 4"
        android:layout_marginTop="8dp" />

</LinearLayout>
